{
  "entities": {
    "SurveyResponse": {
      "title": "SurveyResponse",
      "description": "A visitor dining and marketing research survey submission tied to a single-use survey code.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique survey response identifier.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the response was submitted.",
          "minLength": 10,
          "maxLength": 40
        },
        "submittedDate": {
          "type": "string",
          "description": "YYYY-MM-DD local submission date.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "surveyCode": {
          "type": "string",
          "description": "Single-use survey code activated by Head Office or an authorized branch and atomically redeemed on submission.",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "branch": {
          "type": "string",
          "description": "Jiang Nan branch where the visitor dined.",
          "enum": [
            "BANAWE",
            "BF HOMES",
            "NU MOA",
            "HOLY SPIRIT",
            "HEMADY",
            "PASEO CENTER",
            "FAME MALL",
            "SM EAST ORTIGAS",
            "SM MARILAO",
            "SM MARIKINA",
            "SM FAIRVIEW",
            "STA ROSA",
            "SMDC TAGAYTAY",
            "SM SUCAT",
            "GIL FERNANDO",
            "ORTIGAS CENTER",
            "EASTWOOD CITY",
            "SM CLARK",
            "SM NORTH EDSA",
            "GH PROMENADE",
            "SOUTHMALL"
          ],
          "maxLength": 40
        },
        "consent": {
          "type": "string",
          "description": "Explicit participant consent for marketing research.",
          "enum": ["Yes"]
        },
        "name": {
          "type": "string",
          "description": "Optional respondent display name or empty string for anonymous.",
          "maxLength": 80
        },
        "gender": {
          "type": "string",
          "description": "Respondent gender selection.",
          "enum": ["Male", "Female", "Non-binary", "Prefer not to say"],
          "maxLength": 32
        },
        "ageGroup": {
          "type": "string",
          "description": "Respondent age range.",
          "enum": ["Under 18", "18–24", "25–34", "35–44", "45–54", "55+"],
          "maxLength": 16
        },
        "occupation": {
          "type": "string",
          "description": "Respondent occupation status.",
          "enum": ["Student", "Employed", "Unemployed"],
          "maxLength": 24
        },
        "relationshipStatus": {
          "type": "string",
          "description": "Respondent relationship status.",
          "enum": ["Single", "In a Relationship", "Married", "Prefer not to say"],
          "maxLength": 32
        },
        "diningWith": {
          "type": "string",
          "description": "Dining companion group type.",
          "enum": ["Solo", "Friends", "Family"],
          "maxLength": 16
        },
        "visitFrequency": {
          "type": "string",
          "description": "Whether this is the respondent's first time, 2nd time, or 3 or more times dining with Jiang Nan.",
          "enum": ["First Time", "2nd Time", "3 or More Times"],
          "maxLength": 24
        },
        "partySize": {
          "type": "number",
          "description": "Total number of guests in the dining party (1 to 50)."
        },
        "transportCategory": {
          "type": "string",
          "description": "Private, Public, or On Foot transport classification.",
          "enum": ["Private", "Public", "On Foot"],
          "maxLength": 16
        },
        "transportMode": {
          "type": "string",
          "description": "Specific arrival mode of transport.",
          "enum": [
            "Private Car",
            "Private Motorcycle",
            "Private Tricycle",
            "Public Mototaxi",
            "Public Tricycle",
            "Ride-Hailing App (Grab)",
            "Walked Only"
          ],
          "maxLength": 40
        },
        "origin": {
          "type": "string",
          "description": "Where the visitor came from before arriving.",
          "minLength": 1,
          "maxLength": 80
        },
        "destination": {
          "type": "string",
          "description": "Where the visitor is heading next.",
          "minLength": 1,
          "maxLength": 80
        },
        "currency": {
          "type": "string",
          "description": "Selected budget currency.",
          "enum": ["PHP", "USD"],
          "maxLength": 3
        },
        "spendPerPax": {
          "type": "string",
          "description": "Selected willingness to spend tier or package per person.",
          "minLength": 1,
          "maxLength": 80
        },
        "spendEstimate": {
          "type": "number",
          "description": "Numeric spend estimate per person."
        },
        "orderedTakeout": {
          "type": "boolean",
          "description": "Optional check indicating whether the respondent also ordered for takeout."
        },
        "paymentMethod": {
          "type": "string",
          "description": "Preferred mode of payment.",
          "minLength": 1,
          "maxLength": 60
        },
        "awareOnlineSoloMeal": {
          "type": "string",
          "description": "Legacy optional field for online solo meal awareness.",
          "enum": ["Yes", "No"],
          "maxLength": 3
        }
      },
      "required": [
        "id",
        "submittedAt",
        "submittedDate",
        "surveyCode",
        "consent",
        "name",
        "gender",
        "ageGroup",
        "occupation",
        "relationshipStatus",
        "diningWith",
        "partySize",
        "transportCategory",
        "transportMode",
        "origin",
        "destination",
        "currency",
        "spendPerPax",
        "spendEstimate",
        "paymentMethod"
      ]
    },
    "SurveyCode": {
      "title": "SurveyCode",
      "description": "A single-use survey access code activated by Head Office or an authorized branch dashboard within its Head Office quota.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Normalized uppercase single-use survey code matching the document ID.",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Lifecycle state of the code (active -> used or active -> revoked; terminal once used).",
          "enum": ["active", "used", "revoked"],
          "maxLength": 8
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the code was activated.",
          "minLength": 10,
          "maxLength": 40
        },
        "createdDate": {
          "type": "string",
          "description": "YYYY-MM-DD local activation date.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdBy": {
          "type": "string",
          "description": "Originating dashboard account ('Head Office' or one of the 21 Jiang Nan branches).",
          "maxLength": 40
        },
        "branch": {
          "type": "string",
          "description": "Optional assigned Jiang Nan branch (required and locked when created by a branch dashboard).",
          "enum": [
            "BANAWE",
            "BF HOMES",
            "NU MOA",
            "HOLY SPIRIT",
            "HEMADY",
            "PASEO CENTER",
            "FAME MALL",
            "SM EAST ORTIGAS",
            "SM MARILAO",
            "SM MARIKINA",
            "SM FAIRVIEW",
            "STA ROSA",
            "SMDC TAGAYTAY",
            "SM SUCAT",
            "GIL FERNANDO",
            "ORTIGAS CENTER",
            "EASTWOOD CITY",
            "SM CLARK",
            "SM NORTH EDSA",
            "GH PROMENADE",
            "SOUTHMALL"
          ],
          "maxLength": 40
        },
        "note": {
          "type": "string",
          "description": "Optional reference label (e.g. Lunch shift or Receipt #1042).",
          "maxLength": 80
        },
        "usedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the code was redeemed.",
          "minLength": 10,
          "maxLength": 40
        },
        "usedByResponseId": {
          "type": "string",
          "description": "Survey response document ID that redeemed this code.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "usedAtBranch": {
          "type": "string",
          "description": "Jiang Nan branch where the survey code was actually redeemed.",
          "enum": [
            "BANAWE",
            "BF HOMES",
            "NU MOA",
            "HOLY SPIRIT",
            "HEMADY",
            "PASEO CENTER",
            "FAME MALL",
            "SM EAST ORTIGAS",
            "SM MARILAO",
            "SM MARIKINA",
            "SM FAIRVIEW",
            "STA ROSA",
            "SMDC TAGAYTAY",
            "SM SUCAT",
            "GIL FERNANDO",
            "ORTIGAS CENTER",
            "EASTWOOD CITY",
            "SM CLARK",
            "SM NORTH EDSA",
            "GH PROMENADE",
            "SOUTHMALL"
          ],
          "maxLength": 40
        }
      },
      "required": [
        "code",
        "status",
        "createdAt",
        "createdDate",
        "createdBy"
      ]
    },
    "BranchCodeLimit": {
      "title": "BranchCodeLimit",
      "description": "Head Office–configured survey code generation quota and live usage counter for a specific Jiang Nan branch.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Underscore-normalized branch slug matching the document ID (e.g. SM_NORTH_EDSA).",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[A-Z0-9_]+$"
        },
        "branch": {
          "type": "string",
          "description": "Jiang Nan branch name.",
          "enum": [
            "BANAWE",
            "BF HOMES",
            "NU MOA",
            "HOLY SPIRIT",
            "HEMADY",
            "PASEO CENTER",
            "FAME MALL",
            "SM EAST ORTIGAS",
            "SM MARILAO",
            "SM MARIKINA",
            "SM FAIRVIEW",
            "STA ROSA",
            "SMDC TAGAYTAY",
            "SM SUCAT",
            "GIL FERNANDO",
            "ORTIGAS CENTER",
            "EASTWOOD CITY",
            "SM CLARK",
            "SM NORTH EDSA",
            "GH PROMENADE",
            "SOUTHMALL"
          ],
          "maxLength": 40
        },
        "maxCodes": {
          "type": "number",
          "description": "Maximum number of survey codes this branch is permitted to generate (0 to 10000)."
        },
        "generatedCount": {
          "type": "number",
          "description": "Number of survey codes generated by this branch since the last Head Office reset (0 to 10000)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp of the most recent quota update or branch code generation.",
          "minLength": 10,
          "maxLength": 40
        },
        "updatedBy": {
          "type": "string",
          "description": "Quota authority (always 'Head Office').",
          "enum": ["Head Office"],
          "maxLength": 11
        }
      },
      "required": [
        "id",
        "branch",
        "maxCodes",
        "generatedCount",
        "updatedAt",
        "updatedBy"
      ]
    }
  },
  "firestore": {
    "/surveys/{surveyId}": {
      "schema": {
        "$ref": "#/entities/SurveyResponse"
      },
      "description": "Shared collection of visitor dining survey responses synchronized across all platforms."
    },
    "/surveyCodes/{codeId}": {
      "schema": {
        "$ref": "#/entities/SurveyCode"
      },
      "description": "Single-use survey codes activated by Head Office or authorized branch dashboards and atomically marked as used upon survey submission."
    },
    "/branchCodeLimits/{branchId}": {
      "schema": {
        "$ref": "#/entities/BranchCodeLimit"
      },
      "description": "Per-branch code generation limits configured by Head Office and atomically incremented when a branch generates survey codes."
    }
  }
}
